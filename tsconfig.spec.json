{
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./out-tsc/spec",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": [
      "jest",
      "node",
      "@angular/localize"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "strictNullChecks": false,
    "declaration": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@shared": [
        "src/app/shared"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@models": [
        "src/app/shared/models"
      ],
      "@models/*": [
        "src/app/shared/models/*"
      ],
      "@env": [
        "src/environments/environment"
      ],
      "@env/*": [
        "src/environments/*"
      ]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "setup-jest.ts"
  ]
}
