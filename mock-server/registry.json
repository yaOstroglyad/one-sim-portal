{
  "services": {
    "UsersDataService": {
      "mocked": true,
      "endpoints": ["list", "paginatedUsers", "createUser", "verifyEmail"]
    },
    "TicketsDataService": {
      "mocked": true,
      "endpoints": ["getTickets", "createTicket", "getTicketById", "updateTicket", "deleteTicket", "getRecentTickets", "getTicketCount", "getTicketStats", "getAllCompanyTickets", "getTicketComments", "addComment", "getTicketAttachments", "uploadAttachment"]
    }
  },
  "endpoints": [
    {
      "path": "/api/v1/users/query/all",
      "method": "GET",
      "service": "UsersDataService",
      "handler": "users/list"
    },
    {
      "path": "/api/v1/users/command/create",
      "method": "POST",
      "service": "UsersDataService",
      "handler": "users/create"
    },
    {
      "path": "/api/v1/users/query/verify-user",
      "method": "GET",
      "service": "UsersDataService",
      "handler": "users/verify-email"
    },
    {
      "path": "/api/v1/tickets",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/list"
    },
    {
      "path": "/api/v1/tickets",
      "method": "POST",
      "service": "TicketsDataService",
      "handler": "tickets/create"
    },
    {
      "path": "/api/v1/tickets/:id",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/details"
    },
    {
      "path": "/api/v1/tickets/:id",
      "method": "PATCH",
      "service": "TicketsDataService",
      "handler": "tickets/update"
    },
    {
      "path": "/api/v1/tickets/:id",
      "method": "DELETE",
      "service": "TicketsDataService",
      "handler": "tickets/delete"
    },
    {
      "path": "/api/v1/tickets/recent",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/recent"
    },
    {
      "path": "/api/v1/tickets/count",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/count"
    },
    {
      "path": "/api/v1/tickets/stats",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/stats"
    },
    {
      "path": "/api/v1/tickets/all",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/all-company"
    },
    {
      "path": "/api/v1/tickets/:ticketId/comments",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/comments"
    },
    {
      "path": "/api/v1/tickets/:ticketId/comments",
      "method": "POST",
      "service": "TicketsDataService",
      "handler": "tickets/add-comment"
    },
    {
      "path": "/api/v1/tickets/:ticketId/attachments",
      "method": "GET",
      "service": "TicketsDataService",
      "handler": "tickets/attachments"
    },
    {
      "path": "/api/v1/tickets/:ticketId/attachments",
      "method": "POST",
      "service": "TicketsDataService",
      "handler": "tickets/upload-attachment"
    }
  ]
}
