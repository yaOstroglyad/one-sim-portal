    "@angular/forms": "^21.0.5",
    "@angular/language-service": "^21.0.5",
    "@angular/material": "^21.0.3",
    "@angular/platform-browser": "^21.0.5",
    "@angular/platform-browser-dynamic": "^21.0.5",
    "@angular/router": "^21.0.5",
    "@coreui/angular": "^5.6.2",
    "@coreui/angular-chartjs": "^5.6.2",
    "@coreui/chartjs": "^4.0.0",
    "@coreui/coreui": "^5.1.0",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-angular": "^5.6.2",
    "@coreui/utils": "^2.0.2",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^8.0.0",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "angularx-qrcode": "^21.0.4",
    "chart.js": "^4.4.2",
    "highlight.js": "^11.11.1",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "ngx-cookie-service": "^21.1.0",
    "ngx-scrollbar": "^18.0.0",
    "ngx-webstorage": "^21.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
