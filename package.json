{
  "name": "one-sim-portal",
  "version": "1.0.3",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "start-verbose": "ng serve --verbose --proxy-config proxy.conf.js",
    "start:mock": "concurrently \"npm run mock-server:dev\" \"ng serve --proxy-config mock-server/proxy.conf.mock.js\"",
    "mock-server": "cd mock-server && npm install && npm start",
    "mock-server:dev": "cd mock-server && npm install && npm run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build-prod": "ng build one-sim-portal --configuration production",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.5",
    "@angular/cdk": "^21.0.3",
    "@angular/common": "^21.0.5",
