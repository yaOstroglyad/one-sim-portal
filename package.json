{
  "name": "one-sim-portal",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "start-verbose": "ng serve --verbose --proxy-config proxy.conf.js",
    "start:mock": "concurrently \"npm run mock-server:dev\" \"ng serve --proxy-config mock-server/proxy.conf.mock.js\"",
    "mock-server": "cd mock-server && npm install && npm start",
    "mock-server:dev": "cd mock-server && npm install && npm run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build-prod": "ng build one-sim-portal --configuration production",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^19.2.15",
    "@angular/language-service": "^19.2.15",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@coreui/angular": "~5.1.11",
    "@coreui/angular-chartjs": "~5.1.11",
    "@coreui/chartjs": "^4.0.0",
    "@coreui/coreui": "^5.1.0",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-angular": "~5.1.11",
    "@coreui/utils": "^2.0.2",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.4.2",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "ngx-cookie-service": "^17.1.0",
    "ngx-scrollbar": "^12.0.0",
    "ngx-webstorage": "^12.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.15",
    "@angular/localize": "^19.2.15",
    "@types/jasmine": "^4.3.2",
    "@types/node": "^18.16.18",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sass": "~1.32.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": "^18.13.0 || >=20.9.0",
    "npm": ">= 6"
  }
}
